# Copie este archivo a .env para configurar el entorno.

# URL base del Backend (proyecto Desarrollo Backend, Evaluación Sumativa U2).
# Ejemplo cuando el Backend esté desplegado:
# VITE_API_BASE_URL=https://api-cliente-feliz.onrender.com/api
VITE_API_BASE_URL=/api

# true  -> usa datos simulados en el navegador (localStorage), sin backend real.
# false -> consume el Backend real definido en VITE_API_BASE_URL.
VITE_USE_MOCK=true
